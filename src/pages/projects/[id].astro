---
// 프로젝트 하나의 페이지: 소개 + 이 프로젝트에 연결된 글을 시리즈(오래된 순)로 보여줘요.
// 글은 frontmatter에 `project: <프로젝트 id>` 를 적으면 자동으로 여기 모여요.
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import XpWindow from '@/components/XpWindow.astro';
import Stars from '@/components/Stars.astro';
import PostBanner from '@/components/PostBanner.astro';
import Pn from '@/components/Pn.astro';
import { getPostsByProject } from '@/lib/posts';
import { url } from '@/lib/site';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  const byProject = await getPostsByProject();
  return projects.map((p) => ({
    params: { id: p.id },
    props: { project: { ...p.data, id: p.id }, posts: byProject.get(p.id) ?? [] },
  }));
}

const { project, posts } = Astro.props;
---

<BaseLayout title={project.name} description={project.desc} footerLine="thx for digging into the details, ur hired (jk... unless?)">
  <div class="wrap">
    <Stars stars={[
      { x: '-2%', y: '90px', size: 52, colors: ['#7DF9FF', '#3A0CA3'] },
      { x: 'r-2%', y: '360px', size: 44, colors: ['#FFF27A', '#FF9E1F'], delay: 1 },
    ]} />

    <a class="back f-display" href={url(`/about?tab=projects&p=${project.id}`)}>◀ back to project closet</a>

    <header class="head">
      <div class="meta">
        <span class="f-accent no">PROJECT {project.no}</span>
        <span class="f-hand tag">{project.tag}</span>
      </div>
      <h1 class="wordart title"><Pn text={project.name} /></h1>
    </header>

    <XpWindow title={`${project.id}.txt — project notes`} menu={['File', 'Edit', 'View', 'Help']}>
      <div class="about">
        <p class="f-read desc">{project.desc}</p>
        <div class="tags">{project.stack.map((s) => <span class="f-accent">{s}</span>)}</div>
        {project.link && <a class="btn-aqua ext" href={project.link} target="_blank" rel="noopener">see it live ▶</a>}
      </div>
    </XpWindow>

    <section class="series">
      <h2 class="series-head f-display">
        the series <span class="count f-accent">{posts.length} {posts.length === 1 ? 'post' : 'posts'}</span>
      </h2>
      {posts.length > 0 ? (
        <ol class="list">
          {posts.map((p, i) => (
            <li>
              <span class="part f-accent">part {i + 1}</span>
              <PostBanner post={p} />
            </li>
          ))}
        </ol>
      ) : (
        <p class="empty f-hand">아직 이 프로젝트 글이 없어요. 곧 올라와요!</p>
      )}
    </section>
  </div>
</BaseLayout>

<style>
  .wrap { position: relative; max-width: 900px; margin: 0 auto; padding: 28px 16px 56px; display: flex; flex-direction: column; gap: 22px; }
  .back { align-self: flex-start; color: #FFFFFF; text-decoration: none; text-transform: uppercase; font-size: 14px; text-shadow: 2px 2px 0 var(--ink); position: relative; }
  .back:hover { color: var(--yellow); }
  .head { text-align: center; display: flex; flex-direction: column; gap: 10px; align-items: center; position: relative; }
  .meta { display: flex; gap: 10px; align-items: center; }
  .no { background: var(--ink); color: var(--lime); padding: 0 10px; font-size: 16px; }
  .tag { color: #FFFFFF; font-size: 20px; text-shadow: 1px 1px 0 var(--hot-deep); }
  .title { margin: 0; font-size: clamp(30px, 5.5vw, 48px); line-height: 1.15; }
  .about { background: #FFFFFF; padding: clamp(18px, 4vw, 30px); display: flex; flex-direction: column; gap: 14px; }
  .desc { margin: 0; font-size: 17px; line-height: 1.8; }
  .tags { display: flex; flex-wrap: wrap; gap: 6px; }
  .tags span { font-size: 14px; border: 1.5px solid var(--navy); border-radius: 999px; padding: 0 10px; background: #E4EEFF; }
  .ext { align-self: flex-start; padding: 6px 18px; font-size: 14px; }
  .series { display: flex; flex-direction: column; gap: 14px; position: relative; }
  .series-head { margin: 0; color: #FFFFFF; font-size: 22px; text-transform: uppercase; text-shadow: 3px 3px 0 var(--ink); display: flex; align-items: center; gap: 12px; }
  .count { font-size: 15px; background: var(--yellow); color: var(--ink); padding: 0 10px; text-shadow: none; }
  .list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 18px; }
  .part { display: inline-block; margin-bottom: 6px; font-size: 14px; background: #FFFFFF; color: var(--ink); border: 2px solid var(--ink); padding: 0 10px; }
  .empty { margin: 0; background: #FFFFFF; border: 3px dashed var(--violet); padding: 20px; text-align: center; font-size: 20px; color: var(--violet); }
</style>
