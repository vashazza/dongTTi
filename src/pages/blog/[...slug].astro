---
import { render, getEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import XpWindow from '@/components/XpWindow.astro';
import Stars from '@/components/Stars.astro';
import Comments from '@/components/Comments.astro';
import Pn from '@/components/Pn.astro';
import { getPosts, getPostsByProject } from '@/lib/posts';
import { CATEGORY_LABEL, formatDate, url } from '@/lib/site';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1] ?? null, older: posts[i + 1] ?? null },
  }));
}

const { post, newer, older } = Astro.props;
const { Content } = await render(post);
const { title, subtitle, date, category, readMinutes } = post.data;

// 프로젝트에 연결된 글이면 "이 글은 OO 프로젝트 이야기예요 · PART n / N" 띠를 보여줘요
const project = post.data.project ? await getEntry(post.data.project) : undefined;
const series = project ? (await getPostsByProject()).get(project.id) ?? [] : [];
const part = series.findIndex((p) => p.id === post.id) + 1;
---

<BaseLayout title={title} description={subtitle} footerLine="thx for reading all the way down, ur a real one">
  <div class="wrap">
    <Stars stars={[
      { x: '-2%', y: '120px', size: 56, colors: ['#7DF9FF', '#3A0CA3'] },
      { x: 'r-2%', y: '420px', size: 48, colors: ['#FFF27A', '#FF9E1F'], delay: 1 },
    ]} />

    <header class="head">
      <div class="meta f-accent">
        <span class="cat">{CATEGORY_LABEL[category]}</span>
        <span class="date">{formatDate(date)}</span>
        {readMinutes && <span class="mins">{readMinutes} min read</span>}
      </div>
      <h1 class:list={["wordart title", { long: title.length > 40 }]}><Pn text={title} /></h1>
      {subtitle && <p class="f-hand subtitle">{subtitle}</p>}
    </header>

    {project && (
      <a class="from-project" href={url(`/projects/${project.id}`)}>
        <svg class="folder" viewBox="0 0 24 20" aria-hidden="true"><path d="M1 3 Q1 1 3 1 L9 1 L11 4 L21 4 Q23 4 23 6 L23 17 Q23 19 21 19 L3 19 Q1 19 1 17 Z" fill="#FFE600" stroke="#1B0033" stroke-width="1.8" stroke-linejoin="round"></path></svg>
        <span class="f-ui">이 글은 <b class="f-display pname">{project.data.name}</b> 프로젝트 이야기예요</span>
        {series.length > 1 && <span class="f-accent partno">part {part} / {series.length}</span>}
        <span class="f-display go">see project ▶</span>
      </a>
    )}

    <XpWindow title={`${post.id}.txt — dongTTi notepad`} menu={['File', 'Edit', 'Format', 'Help']}>
      <article class="prose f-read">
        <Content />
      </article>
    </XpWindow>

    <nav class="pager">
      {older ? <a href={url(`/blog/${older.id}`)} class="btn-pill">◀ {older.data.title}</a> : <span />}
      {newer ? <a href={url(`/blog/${newer.id}`)} class="btn-pill">{newer.data.title} ▶</a> : <a href={url('/blog')} class="btn-pill">all posts ▶</a>}
    </nav>

    <Comments />
  </div>
</BaseLayout>

<style>
  .wrap { position: relative; max-width: 860px; margin: 0 auto; padding: 36px 16px 56px; display: flex; flex-direction: column; gap: 24px; }
  .head { text-align: center; display: flex; flex-direction: column; gap: 12px; align-items: center; position: relative; }
  .meta { display: flex; gap: 8px; flex-wrap: wrap; justify-content: center; font-size: 15px; }
  .cat { background: var(--ink); color: var(--lime); padding: 0 10px; }
  .date, .mins { background: #FFFFFF; border: 2px solid var(--ink); padding: 0 10px; }
  .date { background: var(--yellow); }
  .title { margin: 0; font-size: clamp(34px, 6vw, 52px); line-height: 1.12; word-break: keep-all; }
  .title.long { font-size: clamp(22px, 3.4vw, 32px); line-height: 1.25; -webkit-text-stroke-width: 4px; max-width: 820px; }
  .subtitle { margin: 0; font-size: 22px; color: #FFFFFF; text-shadow: 1px 1px 0 #9A0F5E; }
  .pager { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
  .from-project { position: relative; display: flex; flex-wrap: wrap; align-items: center; gap: 10px; padding: 10px 14px; text-decoration: none; color: var(--ink);
    background: linear-gradient(180deg, #FFFDE8, #FFF3A6); border: 3px solid var(--ink); box-shadow: 4px 4px 0 var(--violet); font-size: 15px; transition: transform .12s ease; }
  .from-project:hover { transform: translateY(-2px); color: var(--ink); }
  .from-project .folder { width: 26px; height: 22px; flex: none; }
  .from-project .pname { color: var(--cobalt); text-transform: uppercase; font-weight: 400; }
  .from-project .partno { background: var(--ink); color: var(--lime); padding: 0 8px; font-size: 13px; }
  .from-project .go { margin-left: auto; font-size: 13px; text-transform: uppercase; color: var(--hot-deep); }
  .pager a { font-size: 15px; padding: 6px 12px; text-align: center; }

  .prose { background: #FFFFFF; padding: clamp(20px, 5vw, 40px); font-size: 17px; line-height: 1.85; color: #1B1B3A; }
  .prose :global(p) { margin: 0 0 18px; }
  .prose :global(h2) { font-family: var(--font-display); font-weight: 400; font-style: normal; text-transform: uppercase; font-size: 24px; color: var(--violet);
    margin: 34px 0 12px; padding: 6px 12px; background: linear-gradient(90deg,#FFF27A,rgba(255,242,122,0)); border-left: 6px solid var(--hot); }
  /* velog에서 옮긴 글은 ### 를 주로 써요 */
  .prose :global(h3) { font-family: var(--font-display); font-weight: 400; text-transform: uppercase; font-size: 20px; color: var(--cobalt);
    margin: 30px 0 10px; padding-bottom: 4px; border-bottom: 3px dotted var(--hot); }
  .prose :global(h4) { font-family: var(--font-display); font-weight: 400; font-size: 17px; color: var(--violet); margin: 22px 0 8px; }
  .prose :global(h3:first-child), .prose :global(h2:first-child) { margin-top: 0; }
  .prose :global(hr) { border: 0; border-top: 2px dashed #FF9CCB; margin: 28px 0; }
  .prose :global(strong) { color: #C2007A; }
  .prose :global(:not(pre) > code) { font-family: var(--font-accent); font-size: 19px; background: var(--pink-wash); padding: 0 6px; border: 1px solid #FF9CCB; }
  .prose :global(pre) { padding: 14px 16px; border: 2px solid var(--hot-soft); font-size: 14px; overflow-x: auto; }
  .prose :global(ul) { padding-left: 22px; margin: 0 0 18px; }
  .prose :global(table) { border-collapse: collapse; width: 100%; display: block; overflow-x: auto; margin: 0 0 18px; font-family: var(--font-body); font-size: 15px; }
  .prose :global(th) { background: linear-gradient(180deg,#FFE3F1,#FF9CCB); }
  .prose :global(th), .prose :global(td) { border: 2px solid var(--ink); padding: 8px; text-align: center; }
  .prose :global(blockquote) { margin: 0 0 18px; padding: 10px 14px; background: #FFF9C4; border: 2px dashed var(--ink); transform: rotate(-0.4deg); }
  .prose :global(blockquote p) { margin: 0; }
  .prose :global(img) { border: 3px solid var(--ink); box-shadow: 5px 5px 0 var(--violet); margin: 0 auto 18px; }
</style>
